DISCORD_TOKEN=your_bot_token_here
# Backward-compatible fallback if the three dedicated channels are not set
SCHEDULE_CHANNEL_ID=your_channel_id_here
SIGNAL_CHANNEL_ID=your_signal_channel_id_here
INTERACTION_CHANNEL_ID=your_interaction_channel_id_here
POSITION_CHANNEL_ID=your_position_channel_id_here

POLYGON_API_KEY=your_polygon_api_key_here
MAX_SIGNALS_PER_POLL=3
MAX_SCAN_ROWS=5

# Optional: moomoo/OpenD read-only actual positions
MOOMOO_POSITIONS_ENABLED=0
MOOMOO_AUTO_POSITION_SNAPSHOT=0
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_TRD_MARKET=US
MOOMOO_TRD_ENV=REAL
MOOMOO_ACC_ID=0
MOOMOO_ACC_INDEX=0
# Optional, depends on your SDK/account region. Example: FUTUINC for US docs.
MOOMOO_SECURITY_FIRM=FUTUINC
MOOMOO_SDK_MODULE=moomoo

# Optional: Hugging Face Hub artifact uploads
HF_TOKEN=your_huggingface_token_here
HF_RAW_REPO_ID=your_username/kitty-raw-data
HF_MODEL_REPO_ID=your_username/kitty-models
AUTO_HF_UPLOAD_AFTER_CLOSE=0
